# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# playwright
/tests/.auth/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# desktop library data for migration (never commit book databases)
/migration-data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Claude settings, and the dated copies the editor leaves beside them
.claude/settings.local.json
.claude/settings.local.json.backup*

# library backups (large, and yours alone)
/backups/

# search parity and timing snapshots (local measurement artefacts)
.search-parity-*.json
.search-timing-*.json

# Third-party reference binaries (UyghurEdit distribution) — notes only
/_reference/*
!/_reference/uyedit-test-words.md

# spellcheck corpus scan cache (large, regenerated by the build scripts)
/spellcheck-data/

# Production build used by the offline Playwright specs
.next-e2e/
